{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-intake-verifier/schema/prediction.schema.json",
  "title": "Extractor prediction for one document",
  "description": "What the extractor returns for one PDF. Field keys mirror schema/fields.json and the golden sample, so the two are compared key by key. Produced by the Next.js extractor, validated by both the TypeScript boundary and the Python harness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["prediction_version", "id", "file", "sha256", "extractor", "pages", "fields", "tests", "warnings"],
  "properties": {
    "prediction_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Document id. For synthetic documents, the file stem (synth-000042)." },
    "file": { "type": "string", "minLength": 1, "description": "Base name of the PDF the prediction was made from." },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "model_version", "prompt_version", "input_mode", "temperature", "thinking_level", "attempts", "latency_ms", "usage", "created_at", "error"],
      "properties": {
        "model": { "type": "string", "minLength": 1, "description": "Model id requested." },
        "model_version": { "type": ["string", "null"], "description": "Model version reported by the API, when available." },
        "prompt_version": { "type": "string", "minLength": 1 },
        "input_mode": { "type": "string", "enum": ["pdf-inline", "page-images"] },
        "temperature": { "type": "number", "minimum": 0 },
        "thinking_level": { "type": ["string", "null"] },
        "attempts": { "type": "integer", "minimum": 1 },
        "latency_ms": { "type": "integer", "minimum": 0, "description": "Wall-clock time of all attempts." },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "thinking_tokens"],
          "properties": {
            "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "thinking_tokens": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "created_at": { "type": "string", "minLength": 1, "description": "ISO 8601 timestamp." },
        "error": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "enum": ["api_error", "invalid_json", "schema_mismatch"] },
                "message": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "width_pt", "height_pt"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "width_pt": { "type": "number", "exclusiveMinimum": 0 },
          "height_pt": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Paciente", "FechaNacimiento", "Edad", "Sexo", "DocumentoIdentidad", "Telefono",
        "NombreMedico", "NumeroColegiado", "NumeroPeticion",
        "NombreMutua", "NumeroSolicitudMutua", "NumeroAutorizacion", "NumeroTarjeta"
      ],
      "properties": {
        "Paciente": { "$ref": "#/$defs/nullableField" },
        "FechaNacimiento": { "$ref": "#/$defs/nullableField" },
        "Edad": { "$ref": "#/$defs/nullableField" },
        "Sexo": { "$ref": "#/$defs/nullableField" },
        "DocumentoIdentidad": { "$ref": "#/$defs/nullableField" },
        "Telefono": { "$ref": "#/$defs/nullableField" },
        "NombreMedico": { "$ref": "#/$defs/nullableField" },
        "NumeroColegiado": { "$ref": "#/$defs/nullableField" },
        "NumeroPeticion": { "$ref": "#/$defs/nullableField" },
        "NombreMutua": { "$ref": "#/$defs/nullableField" },
        "NumeroSolicitudMutua": { "$ref": "#/$defs/nullableField" },
        "NumeroAutorizacion": { "$ref": "#/$defs/nullableField" },
        "NumeroTarjeta": { "$ref": "#/$defs/nullableField" }
      }
    },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" },
      "description": "One entry per distinct requested test, in order of first appearance."
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "field", "detail"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["bbox_invalid", "page_out_of_range", "pattern_mismatch", "empty_value", "duplicate_test", "unexpected_key", "title_removed", "control_character", "garbled_text", "retried_garbled_text"]
          },
          "field": { "type": ["string", "null"], "description": "Field name, 'tests' for the test list, or null." },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "description": "Axis-aligned box normalised to page size, origin top-left. Same shape as in the golden.",
      "additionalProperties": false,
      "required": ["x0", "y0", "x1", "y1"],
      "properties": {
        "x0": { "type": "number", "minimum": 0, "maximum": 1 },
        "y0": { "type": "number", "minimum": 0, "maximum": 1 },
        "x1": { "type": "number", "minimum": 0, "maximum": 1 },
        "y1": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "page", "bbox"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "description": "As returned by the model, after trimming. Normalised per schema/fields.json by the model, verified (never repaired) by the boundary." },
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "bbox": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bbox" }] }
      }
    },
    "nullableField": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/field" }]
    }
  }
}
