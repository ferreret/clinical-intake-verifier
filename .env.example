# A deployment's settings (docs/deploy.md). The image sets replay mode and where its data
# is; these are what a deployment adds. For development, see web/.env.example.

# Build arguments: one image per deployment.
BASE_PATH=
DEMO_DATA_URL=
DEMO_DATA_SHA256=

# Settings.
PUBLIC_URL=
MAX_SANDBOXES=
SANDBOX_TTL_HOURS=
REPLAY_SPEED=
