# Copy to web/.env.local. Next.js and the batch runner both read it. Never commit .env.local.
# The only credential the project needs.
GEMINI_API_KEY=

# Optional. Model id used by the extractor.
# GEMINI_MODEL=gemini-3.8-flash

# Optional. Thinking level passed to the model: low, medium or high (gemini-3.8-flash rejects minimal).
# GEMINI_THINKING_LEVEL=low

# Optional. Which model reads the documents: gemini (default) or local (the vision model
# behind LOCAL_LLM_URL; the pages are sent as images and nothing leaves the machine).
# EXTRACTOR_PROVIDER=gemini

# Optional. Which model chooses among catalog candidates in test mapping: local (default,
# LM Studio's server with Qwen loaded) or gemini (the public demo, where no local model runs).
# MAPPING_MODEL_PROVIDER=local
# Optional. Gemini model for test mapping (defaults to the extractor's).
# MAPPING_GEMINI_MODEL=gemini-3.8-flash
# Optional. The local model behind an OpenAI-compatible API, such as LM Studio's server. Used
# by test mapping and, with EXTRACTOR_PROVIDER=local, by the extractor.
# LOCAL_LLM_URL=http://127.0.0.1:1234/v1
# LOCAL_LLM_MODEL=qwen/qwen3.6-35b-a3b

# ---- Batches and the verification workflow (docs/workflow.md) ----
# Optional. replay (default, the public demo: recorded replies, a sandbox per visitor) or live
# (the extractor is called, PDFs can be uploaded, one workspace).
# APP_MODE=replay
# Optional. Workspaces and uploads. Outside the repository by default: in live mode they may
# hold real documents.
# APP_DATA_DIR=~/.clinical-intake-verifier
# Optional. The database each workspace starts as a copy of: the LIS and the catalog
# (npm run seed-lis), with the memory of 400 earlier approved requests (npm run seed-memory).
# LIS_TEMPLATE=../data/lis/seed-42-demo.sqlite
# Optional. The bundled synthetic documents batches are made of.
# DEMO_DOCUMENTS=../data/synth/seed-42
# Optional. The extractor runs replay mode serves, per provider (npm run extract writes them).
# REPLAY_GEMINI_RUN=../data/runs/20261026-gemini-3.8-flash-p6
# REPLAY_LOCAL_RUN=../data/runs/20261026-qwen3.6-35b-a3b-p6-ocr
# Optional. How much faster than recorded a replayed reply comes (1: the measured latency).
# REPLAY_SPEED=20
# Optional. Cached replies of the mapping model, by request.
# MAPPING_MODEL_CACHE=../data/model-cache
# Optional. The mapping model's replies replay mode serves, per line (npm run record-mapping).
# REPLAY_MAPPING=../data/replay/mapping-gemini.json
# Optional. Hours a sandbox lives after its last use.
# SANDBOX_TTL_HOURS=24
# Optional. Documents read at a time per provider.
# QUEUE_CONCURRENCY_GEMINI=4
# QUEUE_CONCURRENCY_LOCAL=1
# Optional. Sandboxes kept at most; a new visitor beyond it takes the place of the one unused
# for longest.
# MAX_SANDBOXES=500
# Optional. Minutes a document stays locked to a technician whose page stopped renewing it.
# LOCK_MINUTES=30
# Optional. Minutes a sandbox must be unused before a new visitor can take its place.
# SANDBOX_IDLE_MINUTES=30
# Optional. The address's origin (without the path), for the absolute URL of the share image.
# PUBLIC_URL=https://demos.example.dev
# Build time only (next build): the path the app is served under, as /name (docs/deploy.md).
# BASE_PATH=
